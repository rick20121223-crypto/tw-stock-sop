# 複製這個檔案為 .streamlit/secrets.toml（本機測試用，這個真檔案不會被 git 追蹤）
# 部署到 Streamlit Community Cloud 時，把同樣的內容貼到
# App → Settings → Secrets 裡即可，不用上傳這個檔案。

FINMIND_TOKEN = "你的 FinMind API Token"
FUGLE_API_KEY = "你的 Fugle 行情 API Key"

# 紙上交易記帳的 Google Sheets 後端（兩個都設定才會啟用，見
# ledger_store.get_ledger_store()；沒設定時自動退回本機 CSV）。
# 設定步驟：
#   1. 到 Google Cloud Console 建立專案（或用現有的），啟用
#      Google Sheets API + Google Drive API
#   2. 建立一個 Service Account，下載 JSON 金鑰
#   3. 建一份新的 Google Sheet（空白即可，工作表會由程式自動建立），
#      把上面 Service Account 的 email 加為「編輯者」共用權限
#   4. 把 JSON 金鑰的完整內容貼進下面 GOOGLE_SERVICE_ACCOUNT_JSON
#      （整份JSON當一個字串，含大括號），試算表網址列的ID貼進
#      GOOGLE_SHEETS_SPREADSHEET_ID
#      注意：如果貼的JSON是多行格式（保留原本縮排），單引號'...'在TOML裡
#      只能單行，要改用三個單引號'''...'''包起來才能跨多行，不然會出現
#      "Unbalanced quotes"的解析錯誤。單行壓成一行就不用管這個。
GOOGLE_SERVICE_ACCOUNT_JSON = '{"type": "service_account", "project_id": "...", ...}'
GOOGLE_SHEETS_SPREADSHEET_ID = "你的試算表ID（Google Sheet網址/d/與/edit中間那一段）"
